{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cleanRepoDir",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build-config-sencha/build/repos"
            ]
        },
        {
            "label": "Generate Doxi JSON",
            "type": "shell",
            "command": "npx",
            "problemMatcher": [],
            "args": [
                "sencha",
                "--debug",
                "doxi",
                "build",
                "-p",
                "${workspaceFolder}/build-config-sencha/configs/doxi/extjs/${input:toolkit}-${input:version}-cmd.json",
                "all-classes"
            ]
        },
        {
            "label": "Generate Diff (MD)",
            "type": "shell",
            "command": "node",
            "args": [
                "${workspaceFolder}/build-config-sencha/node_modules/@sencha/docs-generator/index.js",
                "create-diff-md",
                "--max-old-space-size=4076",
                "--buildConfigsDir=${workspaceFolder}/build-config-sencha",
                "--product=extjs",
                "--old=${input:oldversion}_${input:toolkit}",
                "--oldFile=${workspaceFolder}/build-config-sencha/build/doxi/extjs/${input:oldversion}/all-classes/${input:toolkit}_all-classes.json",
                "--new=${input:newversion}_${input:toolkit}",
                "--newFile=${workspaceFolder}/build-config-sencha/build/doxi/extjs/${input:newversion}/all-classes/${input:toolkit}_all-classes.json",
                "--log",
                "--production=false"
            ]
        },
        {
            "label": "Mocha All",
            "type": "shell",
            "command": "node",
            "problemMatcher": [],
            "args": [
                "${workspaceFolder}/node_modules/mocha/bin/_mocha",
                "--recursive",
                "--timeout",
                "999999",
                "--colors",
                "${workspaceFolder}/tests"
            ],
            "presentation": {
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Mocha Current File",
            "type": "shell",
            "command": "node",
            "problemMatcher": [],
            "args": [
                "${workspaceFolder}/node_modules/mocha/bin/_mocha",
                "--timeout",
                "999999",
                "--colors",
                "${file}"
            ],
            "presentation": {
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "toolkit",
            "description": "Ext JS Toolkit?",
            "options": ["classic", "modern"],
            "default": "classic"
        },
        {
            "type": "pickString",
            "id": "version",
            "description": "Ext JS Version?",
            "options": ["7.9.0", "7.8.0", "7.7.0", "7.6.0", "7.5.1", "7.5.0", "7.4.0", "7.3.0", "7.2.0", "7.1.0", "7.0.0", "6.7.0", "6.6.0", "6.5.3"],
            "default": "7.5.1"
        },
        {
            "type": "pickString",
            "id": "newversion",
            "description": "What is the NEW version?",
            "options": ["7.9.0", "7.8.0", "7.7.0", "7.6.0", "7.5.1", "7.5.0", "7.4.0", "7.3.0", "7.2.0", "7.1.0", "7.0.0", "6.7.0", "6.6.0", "6.5.3"],
            "default": "7.5.1"
        },
        {
            "type": "pickString",
            "id": "oldversion",
            "description": "What is the OLD version?",
            "options": ["7.9.0", "7.8.0", "7.7.0", "7.6.0", "7.5.1", "7.5.0", "7.4.0", "7.3.0", "7.2.0", "7.1.0", "7.0.0", "6.7.0", "6.6.0", "6.5.3"],
            "default": "7.5.1"
        }
    ]
}