{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ESLint plugin",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/lib/test.js",
            "args": [
                // ENTER PATH TO FILE OR FOLDER TO TEST
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug docs-generator to generate Doxi",
            "preLaunchTask": "cleanRepoDir",
            "program": "${workspaceFolder}/build-config-sencha/node_modules/@sencha/docs-generator/index.js",
            "args": [
                "source-api",
                "--max-old-space-size=4076",
                "--buildConfigsDir=${workspaceFolder}/build-config-sencha",
                "--toolkit=${input:toolkit}",
                "--version=${input:version}",
                "--apiSourceDir=../../../../sencha-sdks/sdk-branches/ext-${input:branchFolderName}/",
                "--product=extjs",
                "--doxiBuild=all-classes",
                "--skipSourceFiles=true",
                "--skipGuides=true",
                "--syncRemote=true",
                "--forceDoxi=true",
                "--log",
                "--production"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Mocha All",
            "program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
            "args": [
                "--recursive",
                "--timeout",
                "999999",
                "--colors",
                "${workspaceFolder}/tests"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Mocha Current File",
            "program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
            "args": [
                "--timeout",
                "999999",
                "--colors",
                "${file}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "toolkit",
            "description": "Ext JS Toolkit?",
            "options": ["classic", "modern"],
            "default": "classic"
        },
        {
            "type": "pickString",
            "id": "version",
            "description": "Ext JS Version?",
            "options": ["7.9.0", "7.8.0", "7.7.0", "7.6.0", "7.5.1", "7.5.0", "7.4.0", "7.3.0", "7.2.0", "7.1.0", "7.0.0", "6.7.0", "6.6.0", "6.5.3"],
            "default": "7.5.1"
        },
        {
            "type": "pickString",
            "id": "branchFolderName",
            "description": "SDK branch folder name?",
            "options": ["7.9.0", "7.8.0", "7.7.0", "7.6.0", "7.5.1", "7.5.0","7.5.x", "7.4.x", "7.3.x", "7.2.x", "7.1.x", "7.0.x", "6.7.x", "6.6.x", "6.5.x"],
            "default": "7.5.1"
        }
    ]
}