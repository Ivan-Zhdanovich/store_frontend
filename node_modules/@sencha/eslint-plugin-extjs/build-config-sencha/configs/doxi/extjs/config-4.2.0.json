{
  "version": 1,
  "profiles": {
    "js": {
      "undocumented": true,
      "language": "javascript",
      "builtins": [
        "Mixed",
        "Event",
        "HTMLElement",
        "undefined",
        "null",
        "Window",
        "Error",
        "CSSStyleRule",
        "CSSStyleSheet",
        "Arguments",
        "Integer",
        "XMLElement",
        "TextNode",
        "Uint8Array",
        "NodeList",
        "XMLHttpRequest",
        "FileList",
        "measurement",
        "percent",
        "List",
        "north",
        "east",
        "west",
        "south",
        "center",
        "top",
        "left",
        "right",
        "bottom",
        "HTMLCanvasElement",
        "Region"
      ]
    },
    "sass": {
      "undocumented": true,
      "language": "sass",
      "builtins": [
        "Color",
        "color",
        "list"
      ]
    }
  },
  "sources": [
    {
      "profile": "js",
      "path": [
        "{_myRoot}/configs/doxi/extjs/add-types/js/primitives"
      ]
    },
    {
      "profile": "js",
      "path": [
        "{apiSourceDir}/ext-all-rtl-debug-w-comments.js"
      ]
    },
    {
      "profile": "sass",
      "path": [],
      "comments": "Currently not supporting sass with the eslint plugin for extjs",
      "xpath": [
        "{apiSourceDir}/packages/ext-theme-access/sass/src",
        "{apiSourceDir}/packages/ext-theme-access/sass/var",
        "{apiSourceDir}/packages/ext-theme-access/sass/etc",
        "{apiSourceDir}/packages/ext-theme-access/sass/all",

        "{apiSourceDir}/packages/ext-theme-base/sass/src",
        "{apiSourceDir}/packages/ext-theme-base/sass/var",
        "{apiSourceDir}/packages/ext-theme-base/sass/etc",

        "{apiSourceDir}/packages/ext-theme-classic/sass/src",
        "{apiSourceDir}/packages/ext-theme-classic/sass/var",
        "{apiSourceDir}/packages/ext-theme-classic/sass/etc",

        "{apiSourceDir}/packages/ext-theme-classic-sandbox/sass/src",
        "{apiSourceDir}/packages/ext-theme-classic-sandbox/sass/var",
        "{apiSourceDir}/packages/ext-theme-classic-sandbox/sass/etc",

        "{apiSourceDir}/packages/ext-theme-gray/sass/src",
        "{apiSourceDir}/packages/ext-theme-gray/sass/var",
        "{apiSourceDir}/packages/ext-theme-gray/sass/etc",

        "{apiSourceDir}/packages/ext-theme-neptune/sass/src",
        "{apiSourceDir}/packages/ext-theme-neptune/sass/var",
        "{apiSourceDir}/packages/ext-theme-neptune/sass/etc",

        "{apiSourceDir}/packages/ext-theme-neutral/sass/src",
        "{apiSourceDir}/packages/ext-theme-neutral/sass/var",
        "{apiSourceDir}/packages/ext-theme-neutral/sass/etc"
      ]
    }
  ],
  "outputs": {
    "all": {
      "default": true,
      "depends": [
        "combo-nosrc",
        "all-classes"
      ]
    },
    "combo-nosrc": {
      "type": "json",
      "dir": "{apiInputDir}/{product}/{version}/{toolkit}-json",
      "includeSrc": false,
      "links": true,
      "flatten": true,
      "autoLinks": [
        "text",
        "deprecatedMessage",
        "removedMessage"
      ],
      "renames": {
        "number": "Number",
        "boolean": "Boolean",
        "string": "String"
      }
    },
    "all-classes": {
      "type": "json",
      "dir": "{apiInputDir}/{product}/{version}/all-classes",
      "file": "classic_all-classes.json",
      "includeSrc": false,
      "pretty": true,
      "flatten": false,
      "links": true,
      "autoLinks": [
        "text",
        "deprecatedMessage",
        "removedMessage"
      ],
      "renames": {
        "number": "Number",
        "boolean": "Boolean",
        "string": "String"
      }
    },
    "all-classes-flatten": {
      "type": "json",
      "dir": "{apiInputDir}/{product}/{version}/all-classes-flatten",
      "file": "api_all-classes-flatten.json",
      "includeSrc": true,
      "links": true,
      "flatten": true,
      "pretty": false,
      "autoLinks": [
        "text",
        "deprecatedMessage",
        "removedMessage"
      ],
      "renames": {
        "number": "Number",
        "boolean": "Boolean",
        "string": "String"
      }
    }
  }
}